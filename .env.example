# Frappe/ERPNext Configuration for Bluenet
# Reference: https://github.com/frappe/frappe_docker/blob/main/docs/02-setup/04-env-variables.md

# Release version
ERPNEXT_VERSION=v16.15.1

# Database
DB_PASSWORD=changeit

# LAN access on port 80 (no port needed in browser)
HTTP_PUBLISH_PORT=80

# Only if you use external database (not needed for this setup)
DB_HOST=
DB_PORT=

# Only if you use external Redis (not needed for this setup)
REDIS_CACHE=
REDIS_QUEUE=

# SSL not configured for LAN deployment
LETSENCRYPT_EMAIL=

# Site name is resolved from host header automatically
FRAPPE_SITE_NAME_HEADER=

# Upload limit
CLIENT_MAX_BODY_SIZE=50m
